#!/usr/bin/python3
"""Local administrator password recovery; never accepts passwords in argv."""
import argparse
import getpass
import hashlib
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import tempfile

ACCOUNT = Path('/var/lib/can-hub-web/account.json')
SERVICE = 'can-hub-web.service'

def password_record(password):
    if not 10 <= len(password) <= 128:
        raise ValueError('Hasło musi mieć od 10 do 128 znaków.')
    salt = secrets.token_hex(16)
    digest = hashlib.scrypt(password.encode(), salt=bytes.fromhex(salt), n=16384, r=8, p=1).hex()
    return dict(salt=salt, hash=digest)

def service(action):
    subprocess.run(['systemctl', action, SERVICE], check=True)

def replace_account(path, record):
    metadata = path.stat()
    fd, name = tempfile.mkstemp(prefix='.password-reset-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            os.fchmod(stream.fileno(), 0o600)
            os.fchown(stream.fileno(), metadata.st_uid, metadata.st_gid)
            json.dump(record, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)

def reset(path, password, control=service):
    # Validate before interrupting service. Never reopen first-time setup.
    record = password_record(password)
    if path.is_symlink() or not path.is_file():
        raise ValueError('Brak zwykłego pliku konta. Reset przerwany; konfiguracja bez zmian.')
    control('stop')
    try:
        replace_account(path, record)
    finally:
        # Starting a new process clears all old in-memory web sessions.
        control('start')

def main():
    parser = argparse.ArgumentParser(description='Reset hasła WWW konta omen (wymaga sudo).')
    parser.add_argument('--generate', action='store_true', help='wygeneruj losowe hasło')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('Uruchom przez sudo.')
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error('Wymagany interaktywny terminal; hasło nie może trafiać do przekierowanego wyjścia.')
    print('Reset dotyczy tylko konta WWW omen. Moduły, Modbus i IP pozostają bez zmian.')
    print('Podczas resetu usługa WWW/CAN/Modbus będzie krótko zatrzymana. Wszystkie sesje WWW wygasną.')
    generated = args.generate
    if not generated:
        choice = input('1 — wpisz własne hasło; 2 — wygeneruj losowe; Enter — anuluj: ').strip()
        if choice not in ('1', '2'):
            print('Anulowano.'); return 0
        generated = choice == '2'
    password = secrets.token_urlsafe(24) if generated else getpass.getpass('Nowe hasło: ')
    if not generated and password != getpass.getpass('Powtórz nowe hasło: '):
        raise ValueError('Hasła różnią się. Nie dokonano resetu.')
    password_record(password)
    if input('Wpisz RESET, aby zatwierdzić: ').strip() != 'RESET':
        print('Anulowano.'); return 0
    if generated:
        print('Zapisz hasło w menedżerze haseł (zostanie ustawione w następnym kroku): ' + password, flush=True)
    reset(ACCOUNT, password)
    subprocess.run(['logger', '-t', 'can-hub-password-reset', 'WWW account omen password reset by local administrator'], check=False)
    print('Hasło zmienione. Usługa uruchomiona; zaloguj się ponownie jako omen.')
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print('Błąd resetowania: ' + str(error), file=sys.stderr)
        print('Jeżeli zatwierdzono reset, sprawdź systemctl status can-hub-web.service. Hasło mogło już zostać zmienione.', file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print('\nPrzerwano.', file=sys.stderr)
        sys.exit(1)

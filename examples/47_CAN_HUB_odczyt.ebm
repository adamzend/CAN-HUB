    end if
end if

SetData(data[18], "Weintek", LW, 800, 3)
SetData(a1Lamp, "Weintek", LW, 803, 1)
// Analog 2: Modbus 121..123, LW804..807.
a2Lamp = 11
if connected == true then
    a2Lamp = 1

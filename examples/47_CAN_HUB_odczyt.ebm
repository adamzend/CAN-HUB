    if s5Bits <> 0 then
        s5Lamp = 14
    end if
    // Bit 5: pomiar niegotowy.
    s5Bits = data[13] & 32
    if s5Bits <> 0 then
        s5Lamp = 10
    end if
    // Bity 6 lub 9: brak odpowiedzi / blad komunikacji czujnika.
    s5Bits = data[13] & 576
    if s5Bits <> 0 then
        s5Lamp = 8
    end if
    // Bit 10: bledny format danych.
    s5Bits = data[13] & 1024
    if s5Bits <> 0 then
        s5Lamp = 4
    end if
    // Bity 11, 12 lub 14: zakres / przepelnienie / nasycenie ADC.
    s5Bits = data[13] & 22528

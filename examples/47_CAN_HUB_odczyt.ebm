    end if
end if

// ===== POZYCJA 6: status LW716, komunikat LW729 =====
s6Lamp = 11
if connected == true then
    // Brak bitow statusu: OK. Nierozpoznany blad: stan 2.
    s6Lamp = 1
    if data[16] <> 0 then
        s6Lamp = 2
    end if
    // Szczegoly bledu czujnika: CRC > timeout > inny blad.

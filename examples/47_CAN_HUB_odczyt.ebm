// ANALOG 1..8: ten sam priorytet komunikatow; wartosci w mV.
// Analog 1: Modbus 118..120, LW800..803.
a1Lamp = 11
if connected == true then
    a1Lamp = 1
    if data[19] <> 0 then
        a1Lamp = 2
    end if
    a1Bits = data[19] & 32768
    if a1Bits <> 0 then

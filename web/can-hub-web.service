[Unit]
Description=CAN HUB local web interface
After=network.target can-hub-vcan.service
Wants=can-hub-vcan.service
[Service]
User=canhub
Group=canhub
WorkingDirectory=/opt/can-hub/web
Environment=CAN_HUB_DATA=/var/lib/can-hub-web
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
StateDirectory=can-hub-web
RuntimeDirectory=can-hub-web
RuntimeDirectoryMode=0755
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target

